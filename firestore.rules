rules_version = '2';

// Security rules for the Chemophile online reader.
// Paste this whole file into Firebase console → Firestore Database → Rules, then Publish.
// Replace ADMIN_EMAIL_HERE with the same admin email you put in js/firebase-config.js.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'ADMIN_EMAIL_HERE'; }
    function student() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function promoPath(code) { return /databases/$(database)/documents/promos/$(code); }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function redemptionPath(code, uid) { return /databases/$(database)/documents/promos/$(code)/redemptions/$(uid); }
    function grantPath(uid, ch) { return /databases/$(database)/documents/users/$(uid)/grants/$(ch); }

    // Can the signed-in student open this chapter now? Their ID is active and locked to a device, and either
    // the chapter is one they bought (until the ID's end date, if it has one), or one on their monthly plan
    // that is paid till a later date (subs is a map: chapter → paid-till time).
    function canOpen(ch) {
      return signedIn()
        && student().active == true
        && student().deviceId != null
        && (
          (ch in student().chapters
            && (student().get('expiresAt', null) == null || request.time < student().expiresAt))
          || request.time < student().get('subs', {}).get(ch, timestamp.value(0))
          || (exists(grantPath(request.auth.uid, ch)) && request.time < get(grantPath(request.auth.uid, ch)).data.till)
        );
    }
    // "Free access" for one chapter (users/{uid}/grants/{chapter}), from a promo code a student with an ID
    // enters in their library: the chapter is on the code, it lasts till the code's last date, and in the same
    // write the code's use count goes up by one and the student's first redemption of this code is recorded.
    function validGrant(uid, ch) {
      let d = request.resource.data;
      let p = get(promoPath(d.code)).data;
      return d.keys().hasOnly(['till', 'code', 'at'])
        && d.code is string
        && ch in p.chapters
        && d.till == p.expiresAt
        && promoOpen(p)
        && getAfter(promoPath(d.code)).data.used == p.used + 1
        && !exists(redemptionPath(d.code, uid))
        && existsAfter(redemptionPath(d.code, uid));
    }
    // Details every reader gives once: student or teacher, school or college, city, classes.
    function validProfile(d) {
      return d.role in ['student', 'teacher']
        && d.school is string && d.school.size() >= 2 && d.school.size() <= 100
        && d.city is string && d.city.size() <= 60
        && d.classes is list && d.classes.size() <= 12;
    }

    // A promo code may be used while it is switched on, before its last date, and under its limit.
    function promoOpen(p) { return p.active == true && request.time < p.expiresAt && p.used < p.maxUses; }

    // A promo user is created together with: the code's use count going up by one, and a redemption record.
    function validPromoSignup(uid) {
      let d = request.resource.data;
      let before = get(promoPath(d.promo)).data;
      let after = getAfter(promoPath(d.promo)).data;
      return signedIn() && request.auth.uid == uid
        && d.keys().hasOnly(['name', 'phone', 'loginId', 'chapters', 'active', 'deviceId', 'deviceInfo', 'boundAt', 'createdAt', 'promo', 'expiresAt'])
        && d.promo is string
        && promoOpen(before)
        && after.used == before.used + 1
        && d.chapters == before.chapters
        && d.expiresAt == before.expiresAt
        && d.active == true
        && d.deviceId is string
        && existsAfter(/databases/$(database)/documents/promos/$(d.promo)/redemptions/$(uid));
    }

    // A free sign-up from the reader: the student's own new login makes its own document, with the login ID of
    // its email, no chapters, no plan and no end date, locked to the device it signs up on. Only the admin can
    // add chapters to it later (after payment).
    function validSelfSignup(uid) {
      let d = request.resource.data;
      return signedIn() && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email.split('@')[0] == d.loginId
        && d.keys().hasOnly(['name', 'phone', 'loginId', 'classes', 'chapters', 'active', 'signup', 'deviceId', 'deviceInfo', 'boundAt', 'createdAt', 'role', 'school', 'city', 'profileAt'])
        && d.signup == true && d.active == true && d.chapters == []
        && (!('role' in d) || (validProfile(d) && d.profileAt == request.time))
        && d.classes is list && d.classes.size() >= 1 && d.classes.size() <= 12
        && d.name is string && d.name.size() <= 60
        && d.phone is string && d.phone.size() <= 15
        && d.deviceId is string;
    }

    // One document per student: name, phone, chapters bought, and the device the ID is locked to.
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin() || validPromoSignup(uid) || validSelfSignup(uid);
      allow delete: if isAdmin();
      // A student may only lock their ID to a device when it is not locked yet (only the admin can unlock it),
      // may stamp the time they last opened a book, and may fill in their own details.
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == uid
        && resource.data.deviceId == null
        && request.resource.data.deviceId is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deviceId', 'deviceInfo', 'boundAt'])
      ) || (
        signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadAt'])
        && request.resource.data.lastReadAt == request.time
      ) || (
        signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'school', 'city', 'classes', 'profileAt'])
        && validProfile(request.resource.data)
        && request.resource.data.profileAt == request.time
      ) || (
        // The days they read (for the reading streak), as "YYYY-MM-DD" strings.
        signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readDays'])
        && request.resource.data.readDays is list && request.resource.data.readDays.size() <= 800
      );

      // Free access to one chapter till a date: from a promo code (see validGrant), or given by the admin
      // (for example to a verified teacher). A later code may only lengthen it.
      match /grants/{ch} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow write: if isAdmin();
        allow create: if signedIn() && request.auth.uid == uid && student().get('promo', null) == null && validGrant(uid, ch);
        allow update: if signedIn() && request.auth.uid == uid && student().get('promo', null) == null && validGrant(uid, ch)
          && resource.data.till < request.resource.data.till;
      }

      // Reading record, one document per chapter: last page, highest page, pages seen, minutes, times opened.
      // The student keeps their own; the admin can read it.
      match /reading/{ch} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow write: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['last', 'max', 'seen', 'minutes', 'opens', 'total', 'updatedAt'])
          && request.resource.data.seen is list && request.resource.data.seen.size() <= 2000
          && request.resource.data.minutes is number
          && request.resource.data.updatedAt == request.time;
        allow delete: if isAdmin();
      }

      // Quiz score, one document per chapter: best, last, number of questions, tries. The admin can read it.
      match /quiz/{ch} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow write: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['best', 'last', 'total', 'tries', 'at'])
          && request.resource.data.best is number && request.resource.data.last is number
          && request.resource.data.total is number && request.resource.data.tries is number
          && request.resource.data.best <= request.resource.data.total
          && request.resource.data.at == request.time;
        allow delete: if isAdmin();
      }

      // Bookmarked pages, one document per chapter. The student keeps their own; the admin can read them.
      match /marks/{ch} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow write: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['pages', 'at'])
          && request.resource.data.pages is list && request.resource.data.pages.size() <= 300
          && request.resource.data.at == request.time;
        allow delete: if isAdmin();
      }

      // Log of logins tried from another device, shown to the admin.
      match /attempts/{attemptId} {
        allow create: if signedIn() && request.auth.uid == uid;
        allow read, delete: if isAdmin();
      }
    }

    // The password each student was last given, so the admin can send it again.
    // Only the admin can read it. A student may save their own copy when they change their password in the reader.
    match /secrets/{uid} {
      allow read, write: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['password', 'at'])
        && request.resource.data.password is string;
    }

    // Promo codes made by the admin. Anyone signed in may look up one code by its exact name (not list them),
    // and may raise its use count by one only while creating their own promo account in the same write.
    match /promos/{code} {
      allow get: if signedIn();
      allow list, create, delete: if isAdmin();
      // Either a new promo account is made in the same write, or a student who already has an ID uses the
      // code for the first time (their redemption record is made in the same write).
      allow update: if isAdmin() || (
        signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used'])
        && request.resource.data.used == resource.data.used + 1
        && promoOpen(resource.data)
        && (
          (!exists(userPath(request.auth.uid)) && getAfter(userPath(request.auth.uid)).data.promo == code)
          || (exists(userPath(request.auth.uid)) && student().get('promo', null) == null
            && !exists(redemptionPath(code, request.auth.uid)) && existsAfter(redemptionPath(code, request.auth.uid)))
        )
      );
      match /redemptions/{uid} {
        allow create: if signedIn() && request.auth.uid == uid && (
          (!exists(userPath(uid)) && getAfter(userPath(uid)).data.promo == code)
          || (exists(userPath(uid)) && student().get('promo', null) == null
            && getAfter(promoPath(code)).data.used == get(promoPath(code)).data.used + 1)
        );
        allow read, delete: if isAdmin();
      }
    }

    // Doubts: a reader asks about a page; only they and the admin see it; only the admin answers.
    // The reader may only mark an answer as seen.
    match /doubts/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && exists(userPath(request.auth.uid)) && validDoubt();
      allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']) && request.resource.data.seen == true);
      allow delete: if isAdmin();
    }
    function validDoubt() {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'name', 'loginId', 'phone', 'ch', 'title', 'page', 'text', 'photo', 'status', 'at'])
        && d.uid == request.auth.uid && d.status == 'open'
        && d.text is string && d.text.size() >= 3 && d.text.size() <= 1000
        && d.ch is string && d.ch.size() <= 12 && d.page is int && d.page >= 0 && d.page <= 2000
        && (!('photo' in d) || (d.photo is string && d.photo.size() < 700000))
        && d.at == request.time;
    }

    // The admin lists every student's free access at once.
    match /{path=**}/grants/{ch} {
      allow read: if isAdmin();
    }

    // A teacher asks for free access: their details and a photo of their school ID card. One request per
    // account; after a rejection they may send it again. Only the admin approves (by giving free access).
    match /teacherRequests/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid && exists(userPath(uid)) && validTeacherRequest();
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid && resource.data.status == 'rejected' && validTeacherRequest());
      allow delete: if isAdmin();
    }
    function validTeacherRequest() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'phone', 'school', 'city', 'subject', 'classes', 'photo', 'note', 'status', 'at'])
        && d.status == 'pending'
        && d.name is string && d.name.size() <= 60 && d.phone is string && d.phone.size() <= 15
        && d.school is string && d.school.size() >= 2 && d.school.size() <= 100
        && d.classes is list && d.classes.size() >= 1 && d.classes.size() <= 12
        && d.photo is string && d.photo.size() > 1000 && d.photo.size() < 900000
        && d.at == request.time;
    }

    // The catalog (books, chapters, prices, combos, offer) that the website shows. Anyone may read it.
    match /catalog/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Announcements from the admin, shown on top of the reader.
    match /announcements/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Chapter quizzes, made by the admin. A student can open the quiz of a chapter they can read now.
    match /quizzes/{ch} {
      allow read: if isAdmin() || canOpen(ch);
      allow write: if isAdmin();
    }

    // Chapter info (title, number of pages uploaded, number of quiz questions).
    match /chapters/{chapterId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Page images: only for a chapter the student can open now (see canOpen above).
    match /pages/{pageId} {
      allow read: if isAdmin() || canOpen(resource.data.ch);
      allow write: if isAdmin();
    }
  }
}
