rules_version = '2';

// Security rules for the Chemophile online reader.
// Paste this whole file into Firebase console → Firestore Database → Rules, then Publish.
// Replace ADMIN_EMAIL_HERE with the same admin email you put in js/firebase-config.js.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'ADMIN_EMAIL_HERE'; }
    function student() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function promoPath(code) { return /databases/$(database)/documents/promos/$(code); }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function redemptionPath(code, uid) { return /databases/$(database)/documents/promos/$(code)/redemptions/$(uid); }
    function grantPath(uid, ch) { return /databases/$(database)/documents/users/$(uid)/grants/$(ch); }
    function phonePath(phone) { return /databases/$(database)/documents/phones/$(phone); }
    // A teacher sees the students the admin put under them (users/{uid}.teacherUid = the teacher's uid).
    function isTeacherOf(uid) { return signedIn() && get(userPath(uid)).data.get('teacherUid', null) == request.auth.uid; }

    // Can the signed-in student open this chapter now? Their ID is active and locked to a device, and either
    // the chapter is one they bought (until the ID's end date, if it has one), or one on their monthly plan
    // that is paid till a later date (subs is a map: chapter → paid-till time), or free access from a promo
    // code, or the admin made the chapter free for everyone who signs up (chapters/{chapter}.free).
    function canOpen(ch) {
      return canOpenOne(ch) || (isPartKey(ch) && partIncluded(ch) && canOpenOne(parentOf(ch)));
    }
    // A chapter's JEE / NEET extra topics have the key class-(1000 + n), e.g. 11-1001 for 11-1. When the admin
    // marks them "included with the chapter" (chapters/{key}.included), whoever can open the chapter opens them too.
    function isPartKey(ch) { return ch.matches('^[0-9]+-[0-9]{4}$'); }
    function parentOf(ch) { return ch.split('-')[0] + '-' + string(int(ch.split('-')[1]) % 1000); }
    function partIncluded(ch) {
      return exists(/databases/$(database)/documents/chapters/$(ch))
        && get(/databases/$(database)/documents/chapters/$(ch)).data.get('included', false) == true;
    }
    function canOpenOne(ch) {
      return signedIn()
        && student().active == true
        && student().deviceId != null
        && (
          (ch in student().chapters
            && (student().get('expiresAt', null) == null || request.time < student().expiresAt))
          || request.time < student().get('subs', {}).get(ch, timestamp.value(0))
          || (exists(grantPath(request.auth.uid, ch)) && request.time < get(grantPath(request.auth.uid, ch)).data.till)
          || (exists(/databases/$(database)/documents/chapters/$(ch)) && get(/databases/$(database)/documents/chapters/$(ch)).data.get('free', false) == true)
        );
    }
    // "Free access" for one chapter (users/{uid}/grants/{chapter}), from a promo code a student with an ID
    // enters in their library: the chapter is on the code, it lasts till the code's last date, and in the same
    // write the code's use count goes up by one and the student's first redemption of this code is recorded.
    function validGrant(uid, ch) {
      let d = request.resource.data;
      let p = get(promoPath(d.code)).data;
      return d.keys().hasOnly(['till', 'code', 'at'])
        && d.code is string
        && ch in p.chapters
        && d.till == p.expiresAt
        && promoOpen(p)
        && getAfter(promoPath(d.code)).data.used == p.used + 1
        && !exists(redemptionPath(d.code, uid))
        && existsAfter(redemptionPath(d.code, uid));
    }
    // Details every reader gives once: student or teacher, school or college, city, classes.
    function validProfile(d) {
      return d.role in ['student', 'teacher']
        && d.school is string && d.school.size() >= 2 && d.school.size() <= 100
        && d.city is string && d.city.size() <= 60
        && d.classes is list && d.classes.size() <= 12;
    }

    // A promo code may be used while it is switched on, before its last date, and under its limit.
    function promoOpen(p) { return p.active == true && request.time < p.expiresAt && p.used < p.maxUses; }

    // A free sign-up from the reader: the student's own new login makes its own document, with the login ID of
    // its email, no chapters, no plan and no end date, locked to the device it signs up on. Only the admin can
    // add chapters to it later (after payment). One WhatsApp number, one student: the number must be free, and
    // its link (phones/{number}) is made in the same write.
    function validSelfSignup(uid) {
      let d = request.resource.data;
      return signedIn() && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email.split('@')[0] == d.loginId
        && d.keys().hasOnly(['name', 'phone', 'loginId', 'classes', 'chapters', 'active', 'signup', 'deviceId', 'deviceInfo', 'boundAt', 'createdAt', 'role', 'school', 'city', 'profileAt'])
        && d.signup == true && d.active == true && d.chapters == []
        && (!('role' in d) || (validProfile(d) && d.profileAt == request.time))
        && d.classes is list && d.classes.size() >= 1 && d.classes.size() <= 12
        && d.name is string && d.name.size() <= 60
        && d.phone is string && d.phone.matches('^[0-9]{10}$')
        && !exists(phonePath(d.phone)) && getAfter(phonePath(d.phone)).data.uid == uid
        && d.deviceId is string;
    }

    // One document per student: name, phone, chapters bought, and the device the ID is locked to.
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid)
        || (signedIn() && resource.data.teacherUid == request.auth.uid);
      // Every reader signs up with their own login ID (a promo code is used after that, on the same ID).
      allow create: if isAdmin() || validSelfSignup(uid);
      allow delete: if isAdmin();
      // A student may only lock their ID to a device when it is not locked yet (only the admin can unlock it),
      // may stamp the time they last opened a book, and may fill in their own details.
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == uid
        && resource.data.deviceId == null
        && request.resource.data.deviceId is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deviceId', 'deviceInfo', 'boundAt'])
      ) || (
        signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadAt'])
        && request.resource.data.lastReadAt == request.time
      ) || (
        // The time they last opened the app (the admin sees who has not opened it for 7+ days).
        signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt'])
        && request.resource.data.lastSeenAt == request.time
      ) || (
        signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'school', 'city', 'classes', 'profileAt'])
        && validProfile(request.resource.data)
        && request.resource.data.profileAt == request.time
      ) || (
        // The days they read (for the reading streak), as "YYYY-MM-DD" strings.
        signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readDays'])
        && request.resource.data.readDays is list && request.resource.data.readDays.size() <= 800
      ) || (
        // The time they changed their password (other logins of the ID then log out).
        signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pwAt'])
        && request.resource.data.pwAt == request.time
      ) || (
        // An old promo-code reader makes their own login ID and password: the account becomes a normal
        // signed-up ID (its promo chapters move to free access till the same date, see grants below).
        signedIn() && request.auth.uid == uid
        && resource.data.get('promo', null) is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['loginId', 'promo', 'chapters', 'expiresAt', 'signup', 'convertedAt', 'phone'])
        // their own WhatsApp number, not one another student already has (linked in the same write)
        && request.resource.data.phone.matches('^[0-9]{10}$')
        && getAfter(phonePath(request.resource.data.phone)).data.uid == uid
        && !('promo' in request.resource.data) && !('expiresAt' in request.resource.data)
        && request.resource.data.chapters == [] && request.resource.data.signup == true
        && request.resource.data.loginId == request.auth.token.email.split('@')[0]
        && request.resource.data.convertedAt == request.time
      );

      // Free access to one chapter till a date: from a promo code (see validGrant), or given by the admin
      // (for example to a verified teacher). A later code may only lengthen it.
      match /grants/{ch} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow write: if isAdmin();
        allow create: if signedIn() && request.auth.uid == uid && student().get('promo', null) == null && validGrant(uid, ch);
        allow update: if signedIn() && request.auth.uid == uid && student().get('promo', null) == null && validGrant(uid, ch)
          && resource.data.till < request.resource.data.till;
        // When an old promo-code reader makes their ID (in the same write), each chapter of their code stays
        // open till the code's same last date.
        allow create: if signedIn() && request.auth.uid == uid
          && student().get('promo', null) is string
          && request.resource.data.keys().hasOnly(['till', 'code', 'at'])
          && request.resource.data.code == student().promo
          && ch in student().chapters
          && request.resource.data.till == student().expiresAt
          && getAfter(userPath(uid)).data.get('promo', null) == null;
      }

      // Reading record, one document per chapter: last page, highest page, pages seen, minutes, times opened.
      // The student keeps their own; the admin can read it.
      match /reading/{ch} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid) || isTeacherOf(uid);
        allow write: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['last', 'max', 'seen', 'minutes', 'opens', 'total', 'updatedAt'])
          && request.resource.data.seen is list && request.resource.data.seen.size() <= 2000
          && request.resource.data.minutes is number
          && request.resource.data.updatedAt == request.time;
        allow delete: if isAdmin();
      }

      // Quiz score, one document per chapter ({chapter}-qb for question bank practice): best, last, number
      // of questions, tries, and hist (the scores of the last few tries). The admin can read it.
      match /quiz/{ch} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid) || isTeacherOf(uid);
        allow write: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['best', 'last', 'total', 'tries', 'at', 'hist'])
          && request.resource.data.best is number && request.resource.data.last is number
          && request.resource.data.total is number && request.resource.data.tries is number
          && request.resource.data.best <= request.resource.data.total
          && (!('hist' in request.resource.data) || (request.resource.data.hist is list && request.resource.data.hist.size() <= 12))
          && request.resource.data.at == request.time;
        allow delete: if isAdmin();
      }

      // Bookmarked pages, one document per chapter. The student keeps their own; the admin can read them.
      match /marks/{ch} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow write: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['pages', 'at'])
          && request.resource.data.pages is list && request.resource.data.pages.size() <= 300
          && request.resource.data.at == request.time;
        allow delete: if isAdmin();
      }

      // Log of logins tried from another device, shown to the admin.
      match /attempts/{attemptId} {
        allow create: if signedIn() && request.auth.uid == uid;
        allow read, delete: if isAdmin();
      }
    }

    // The password each student was last given, so the admin can send it again.
    // Only the admin can read it. A student may save their own copy when they change their password in the reader.
    match /secrets/{uid} {
      allow read, write: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['password', 'at'])
        && request.resource.data.password is string;
    }

    // Promo codes made by the admin. Anyone may look up one code by its exact name (not list them), so the
    // sign-up form can check a code before making the account. A signed-in student may raise its use count by
    // one only together with their own redemption record.
    match /promos/{code} {
      allow get: if true;
      allow list, create, delete: if isAdmin();
      // A student with an ID uses the code for the first time (their redemption record is made in the same write).
      allow update: if isAdmin() || (
        signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used'])
        && request.resource.data.used == resource.data.used + 1
        && promoOpen(resource.data)
        && exists(userPath(request.auth.uid)) && student().get('promo', null) == null
        && !exists(redemptionPath(code, request.auth.uid)) && existsAfter(redemptionPath(code, request.auth.uid))
      );
      match /redemptions/{uid} {
        allow create: if signedIn() && request.auth.uid == uid
          && exists(userPath(uid)) && student().get('promo', null) == null
          && getAfter(promoPath(code)).data.used == get(promoPath(code)).data.used + 1;
        allow read, delete: if isAdmin();
      }
    }

    // Doubts: a reader asks about a page; only they and the admin see it; only the admin answers.
    // The reader may only mark an answer as seen.
    match /doubts/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && exists(userPath(request.auth.uid)) && validDoubt();
      allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']) && request.resource.data.seen == true);
      allow delete: if isAdmin();
    }
    function validDoubt() {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'name', 'loginId', 'phone', 'ch', 'title', 'page', 'text', 'photo', 'status', 'at'])
        && d.uid == request.auth.uid && d.status == 'open'
        && d.text is string && d.text.size() >= 3 && d.text.size() <= 1000
        && d.ch is string && d.ch.size() <= 12 && d.page is int && d.page >= 0 && d.page <= 2000
        && (!('photo' in d) || (d.photo is string && d.photo.size() < 700000))
        && d.at == request.time;
    }

    // Reviews students send from the app. Only the admin reads them and chooses which ones show on the website
    // (the website shows only the approved ones, copied into the catalog).
    match /reviews/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && exists(userPath(request.auth.uid))
        && request.resource.data.keys().hasOnly(['uid', 'name', 'school', 'city', 'cls', 'stars', 'text', 'consent', 'status', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.text is string && request.resource.data.text.size() >= 3 && request.resource.data.text.size() <= 400
        && request.resource.data.consent is bool && request.resource.data.status == 'new'
        && request.resource.data.at == request.time;
      allow update, delete: if isAdmin();
    }

    // The admin lists every student's free access, and every reading record (for graphs and copy alerts), at once.
    match /{path=**}/grants/{ch} {
      allow read: if isAdmin();
    }
    match /{path=**}/reading/{ch} {
      allow read: if isAdmin();
    }
    // Every student's quiz scores at once, for the admin's "who scored what" list.
    match /{path=**}/quiz/{ch} {
      allow read: if isAdmin();
    }

    // A teacher asks for free access: their details and a photo of their school ID card. One request per
    // account; after a rejection they may send it again. Only the admin approves (by giving free access).
    match /teacherRequests/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid && exists(userPath(uid)) && validTeacherRequest();
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid && resource.data.status == 'rejected' && validTeacherRequest());
      allow delete: if isAdmin();
    }
    function validTeacherRequest() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'phone', 'school', 'city', 'subject', 'classes', 'photo', 'note', 'status', 'at'])
        && d.status == 'pending'
        && d.name is string && d.name.size() <= 60 && d.phone is string && d.phone.size() <= 15
        && d.school is string && d.school.size() >= 2 && d.school.size() <= 100
        && d.classes is list && d.classes.size() >= 1 && d.classes.size() <= 12
        && d.photo is string && d.photo.size() > 1000 && d.photo.size() < 900000
        && d.at == request.time;
    }

    // Log in with a phone number: phones/{10-digit number} = { id: login ID, uid }. Anyone may look up one
    // number (not list them) to find its login ID; the password is still needed. A student may link their own
    // number to their own ID once (one ID per number); the admin may change or remove any link.
    match /phones/{phone} {
      allow get: if true;
      allow list, write: if isAdmin();
      allow create: if signedIn() && phone.matches('^[0-9]{10}$')
        && request.resource.data.keys().hasOnly(['id', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.id == request.auth.token.email.split('@')[0]
        && getAfter(userPath(request.auth.uid)).data.phone == phone
        && getAfter(userPath(request.auth.uid)).data.loginId == request.resource.data.id;
    }

    // Day-wise activity: daily/{YYYY-MM-DD}_{uid} = { uid, date, minutes, ch: { chapter: { m: minutes, p: [pages] } },
    // quiz: { quiz: { s: last score, n: out of, t: tries } }, last: time }. The reader adds to its own day; the
    // admin reads every day of every student (by date, or by student).
    match /daily/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.date is string && request.resource.data.date.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
        && id == request.resource.data.date + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'date', 'minutes', 'ch', 'quiz', 'last'])
        && (!('minutes' in request.resource.data) || (request.resource.data.minutes is number && request.resource.data.minutes <= 1440))
        && (!('ch' in request.resource.data) || (request.resource.data.ch is map && request.resource.data.ch.size() <= 40))
        && (!('quiz' in request.resource.data) || (request.resource.data.quiz is map && request.resource.data.quiz.size() <= 80))
        && request.resource.data.last == request.time;
      allow delete: if isAdmin();
    }

    // Website visits, counted once a day per browser: visits/{YYYY-MM-DD}_{class} = { date, cls, n }.
    // cls is the class the visitor chose ("9" … "12", "101" …), or "all" (teacher of several classes,
    // parent, or not chosen). Anyone may add one to the count; only the admin reads (or deletes old days).
    match /visits/{id} {
      allow read, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['date', 'cls', 'n'])
        && request.resource.data.date is string && request.resource.data.date.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
        && request.resource.data.cls is string && request.resource.data.cls.matches('^(all|[0-9]{1,3})$')
        && id == request.resource.data.date + '_' + request.resource.data.cls
        && request.resource.data.n == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n'])
        && request.resource.data.n == resource.data.n + 1;
    }

    // The free 5-question test on the website: minitests/{class} holds the questions (made by the admin from
    // the chapter quizzes; anyone may read them). tests/{id} is one try: the student's name, school, WhatsApp
    // number, class and score. Anyone may save a try; only the admin reads them, marks them contacted, or deletes.
    match /minitests/{cls} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /tests/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['name', 'school', 'phone', 'cls', 'score', 'n', 'chapters', 'at', 'day'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
        && request.resource.data.school is string && request.resource.data.school.size() <= 100
        && request.resource.data.phone is string && request.resource.data.phone.matches('^[0-9]{10}$')
        && request.resource.data.cls is int && request.resource.data.cls > 0 && request.resource.data.cls < 1000
        && request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 10
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= request.resource.data.n
        && request.resource.data.chapters is list && request.resource.data.chapters.size() <= 10
        && request.resource.data.day is string && request.resource.data.day.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
        && request.resource.data.at == request.time;
    }

    // The catalog (books, chapters, prices, combos, offer) that the website shows. Anyone may read it.
    match /catalog/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Announcements from the admin, shown on top of the reader.
    match /announcements/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Chapter quizzes, made by the admin. A student can open the quiz of a chapter they can read now.
    match /quizzes/{ch} {
      allow read: if isAdmin() || canOpen(ch);
      allow write: if isAdmin();
    }

    // Question banks (practice questions with solutions), one per chapter, made by the admin.
    // A student can open the question bank of a chapter they can read now.
    match /qbank/{ch} {
      allow read: if isAdmin() || canOpen(ch);
      allow write: if isAdmin();
    }

    // Chapter info (title, number of pages uploaded, number of quiz questions).
    match /chapters/{chapterId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Page images: only for a chapter the student can open now (see canOpen above).
    match /pages/{pageId} {
      allow read: if isAdmin() || canOpen(resource.data.ch);
      allow write: if isAdmin();
    }
  }
}
